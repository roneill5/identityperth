{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "description": "Sanity Studio for identityperth.com",
  "main": "package.json",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build ../web/public/backend -y && node scripts/studio-light.mjs",
    "deploy": "sanity deploy",
    "typegen": "sanity schemas extract --force --enforce-required-fields && sanity typegen generate",
    "seed:build": "node scripts/seed-from-v1.mjs",
    "seed:import": "sanity dataset import seed/v1.ndjson production --replace"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/icons": "^5.2.3",
    "@sanity/orderable-document-list": "^2.0.28",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "sanity": "^6.19.0",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
