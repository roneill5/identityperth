# Dependencies
node_modules/

# Build output
dist/
.astro/
.sanity/
.wrangler/
.output/

# Environment and secrets
.env
.env.*
!.env.example
.dev.vars

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
npm-debug.log*

# Generated seed data (references files on the machine that built it)
backend/seed/
# The Studio build lands here before Astro copies it into dist/backend.
web/public/backend/
# Share images rendered by web/scripts/og.mjs before every build
web/public/og/
# A local stand-in for the showreel until it is on Cloudflare Stream (README)
web/public/media/
web/src/generated/
# X-Robots-Tag for staging builds, written by web/scripts/headers.mjs
web/public/_headers
# Generated by `wrangler types` (web/): binding types from wrangler.jsonc and .dev.vars
web/worker-configuration.d.ts

# Research notes and large local-only assets
/research/

# Capraia (CAST) needs a webfont licence from MyFonts before it can ship. Hansief is free for web use (see research/fonts/hansief-eula.pdf)
web/public/fonts/capraia-*.woff2

# Cloudflare API tokens, one line each, never commit: Stream (backend/scripts/stream-videos.mjs), the account master token, and a user token for Workers Builds
.stream-token
.cloudflare-token
.cloudflare-user-token

# TypeScript incremental build state
*.tsbuildinfo
