{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Deliberately NOT "identity-perth": that Worker belongs to the archived v1 site.
	"name": "identityperth",
	// Ross's Identity account (the zone identityperth.com lives there too).
	"account_id": "52679bd17ed4c9b4f19165dd37d76f7d",
	// Live on identityperth.com only (custom domains, 3 Nov). The workers.dev address is
	// off so the live site has one address; staging is its own Worker (staging/).
	"workers_dev": false,
	"preview_urls": false,
	// Astro's Cloudflare adapter provides the Worker. It only answers the routes
	// that are not prerendered (the Studio's deep links and the draft preview).
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-10-16",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		// Everything else is answered straight from the asset store.
		"run_worker_first": ["/backend", "/backend/*", "/preview", "/preview/*"]
	}
}
