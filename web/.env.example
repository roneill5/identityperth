# Public values only. Sanity project IDs and dataset names are not secrets.
PUBLIC_SANITY_PROJECT_ID=t2bz0tb2
PUBLIC_SANITY_DATASET=production
# Analytics, on identityperth.com only (README, Analytics).
# true: Cloudflare Zaraz sends GA4 (set up in the Cloudflare dashboard, auto-inject off).
PUBLIC_ZARAZ=
# Google's own GA4 tag instead of Zaraz (G-XXXXXXXXXX). Ignored when PUBLIC_ZARAZ is true.
PUBLIC_GA_ID=
# Microsoft Clarity project ID: session recordings and heatmaps.
PUBLIC_CLARITY_ID=
