---
/**
 * A simple page for documents (the legal pages), in the site's colours,
 * type and cursor but without its moving parts: a bar with the lockup and a
 * link home, the page, a hairline footer. No sidebar, menu, client router or
 * scroll effects, so every link out of here is an ordinary page load
 * (Ross, 28 Oct). The bars run full width; what sits in them and the page
 * itself are held to 1200px and centred (Ross, 30 Oct).
 */
import '../styles/global.css';
import SiteHead from '../components/SiteHead.astro';
import Wordmark from '../components/Wordmark.astro';
import Cursor from '../components/Cursor.astro';
import { getSettings } from '../sanity/fetch';
import { client } from '../sanity/client';
import { PRIVACY_LINKED } from '../lib/site';
import { stegaClean } from '@sanity/client/stega';

interface Props {
	title?: string;
	description?: string | null;
	image?: string | null;
	/** The 404: shares the default card. */
	notFound?: boolean;
}

const settings = await getSettings(Astro.locals.sanity ?? client);
const email = settings?.email ? stegaClean(settings.email) : null;
const year = new Date().getFullYear();
const box = 'mx-auto w-full max-w-[1200px]';
const bar = `${box} flex items-center justify-between gap-6 px-[14px] lg:px-gutter`;
---

<!doctype html>
<html lang="en-AU" class="scroll-smooth" data-preview={Astro.locals.preview ? '' : undefined}>
	<head>
		<SiteHead title={Astro.props.title} description={Astro.props.description} image={Astro.props.image} notFound={Astro.props.notFound} />
	</head>
	<body class="flex min-h-dvh flex-col bg-ink text-paper">
		<a href="#main" class="skip-link">Skip to content</a>
		<div class="scroll-line" aria-hidden="true"></div>
		<header class="border-b border-slate">
			<div class:list={[bar, 'h-[72px]']}>
				<a href="/" class="inline-block py-3 text-lime" aria-label="Identity home">
					<Wordmark class="h-[22px]" />
				</a>
				<a href="/" class="type-label inline-block py-3 text-paper transition-colors duration-200 hover:text-lime">Back to home</a>
			</div>
		</header>
		<main id="main" tabindex="-1" class="flex-1 outline-none">
			<div class={box}>
				<slot />
			</div>
		</main>
		<footer class="border-t border-slate">
			<div class:list={[bar, 'type-small flex-wrap py-6 text-paper/60']}>
				<p>© {year} Identity Perth Pty Ltd</p>
				<p class="flex gap-5">
					{email && <a href={`mailto:${email}`} class="text-link hover:text-lime">{email}</a>}
					<a href="/" class="text-link hover:text-lime">identityperth.com</a>
					{PRIVACY_LINKED && <a href="/privacy" class="text-link hover:text-lime">Privacy</a>}
				</p>
			</div>
		</footer>
		<Cursor />
		<script>
			import { initCursor } from '../scripts/cursor';
			import { initAnalytics } from '../scripts/analytics';
			initAnalytics();
			const line = document.querySelector<HTMLElement>('.scroll-line');
			const draw = () => {
				const room = document.documentElement.scrollHeight - window.innerHeight;
				if (line) line.style.transform = `scaleX(${room > 0 ? Math.min(1, window.scrollY / room) : 0})`;
			};
			addEventListener('scroll', draw, { passive: true });
			addEventListener('resize', draw);
			draw();
			// The preview's editing overlays sit where the cursor's styles cannot reach (as in app.ts).
			if (!document.documentElement.hasAttribute('data-preview')) initCursor();
		</script>
	</body>
</html>
