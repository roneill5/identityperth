---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import MenuOverlay from '../components/MenuOverlay.astro';
import Cursor from '../components/Cursor.astro';
import SiteHead from '../components/SiteHead.astro';
import { getSettings } from '../sanity/fetch';
import { client } from '../sanity/client';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	/** A title from the SEO tab, used as it is (SiteHead). */
	metaTitle?: string | null;
	description?: string | null;
	image?: string | null;
	/**
	 * Page kind, mirrored onto <body data-page>. "splash" hides the sidebar
	 * and lets the hero fill the viewport (the home page). "notfound" marks
	 * the 404.
	 */
	page?: 'splash' | 'default' | 'notfound';
	/** Extra classes on <main>. */
	class?: string;
	/** Extra schema.org nodes for this page (SiteHead). */
	schema?: Record<string, unknown>[];
}

const settings = await getSettings(Astro.locals.sanity ?? client);
const preview = Boolean(Astro.locals.preview);
const page = Astro.props.page ?? 'default';
import PreviewEditing from '../components/PreviewEditing.astro';
---

<!doctype html>
<html lang="en-AU" data-preview={preview ? '' : undefined} transition:animate="none">
	<head>
		<SiteHead title={Astro.props.title} metaTitle={Astro.props.metaTitle} description={Astro.props.description} image={Astro.props.image} notFound={page === 'notfound'} schema={Astro.props.schema} />
		<!-- Client-side navigation; scripts/app.ts swaps #page and #ticker and animates. -->
		<ClientRouter fallback="swap" />
		<slot name="head" />
	</head>
	<body class="bg-ink text-paper" data-page={page}>
		<a href="#main" class="skip-link">Skip to content</a>
		<div class="scroll-line" aria-hidden="true"></div>
		<Sidebar pathname={Astro.url.pathname} />
		<main id="page" class:list={['site-main relative min-h-[calc(100dvh-100px)] lg:min-h-dvh', Astro.props.class]}>
			{/* A tab opened before 6 Nov runs scripts that never move to a newer build: they swap each next page in
			    and run what it carries, this included. Run like that, after its page has loaded, it reloads the page,
			    so the tab picks up the current build. Tabs from later builds load a newer build's pages in full
			    themselves (scripts/app.ts) and have __build set, so this does nothing there. */}
			<script is:inline>document.readyState === 'complete' && !window.__build && location.reload();</script>
			<div id="main" tabindex="-1" class="outline-none" data-page={page}>
				<slot />
			</div>
		</main>
		<!-- The home page's ticker screen, swapped along with #page so it
		     arrives with the page on every visit; the curtain lifts it out of
		     here before a swap. Empty everywhere else. -->
		<div id="ticker"><slot name="ticker" /></div>
		<MenuOverlay settings={settings} />
		<Cursor />


		<script src="../scripts/app.ts"></script>
		{preview && <PreviewEditing />}
	</body>
</html>
