---
/** Renders a Sanity `media` object: an image or a video. */
import SanityImage, { type Figure } from './SanityImage.astro';
import VideoEmbed from './VideoEmbed.astro';
import { hasVideo, type VideoData } from '../lib/video';

export interface MediaData {
	kind?: 'image' | 'video' | null;
	image?: Figure | null;
	video?: VideoData | null;
}

interface Props {
	media: MediaData;
	aspect?: number;
	portraitAspect?: number;
	fill?: boolean;
	sizes?: string;
	loading?: 'lazy' | 'eager';
	fetchpriority?: 'high' | 'low' | 'auto';
	/** This is the page's first picture: add a preload hint. */
	preload?: boolean;
	/** Play a video from its MP4 file (VideoEmbed `file`): covers, which the flip carries between pages. */
	file?: boolean;
	class?: string;
}

const { media, aspect, portraitAspect, fill, sizes, loading, fetchpriority, preload, file, class: className } = Astro.props;
const showVideo = media.kind === 'video' && hasVideo(media.video);
---

{showVideo ? (
	<VideoEmbed video={media.video!} aspect={aspect} portraitAspect={portraitAspect} fill={fill} sizes={sizes} class={className} loading={loading} fetchpriority={fetchpriority} preload={preload} file={file} />
) : media.image?.asset ? (
	<SanityImage
		image={media.image}
		aspect={aspect}
		portraitAspect={portraitAspect}
		fill={fill}
		sizes={sizes}
		loading={loading}
		fetchpriority={fetchpriority}
		preload={preload}
		class={className}
	/>
) : null}
