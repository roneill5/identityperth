---
/**
 * The next project, at the foot of a project page: a lime serif headline
 * (no full stop: Ross, 5 Nov) over the standard project card
 * turned round: on devices with a mouse the wash and text show at rest over a
 * black and white cover, and hovering clears the wash to bring the colour
 * back (Ross, 26 Oct). Phones keep the cover in colour with the caption row,
 * since they cannot hover.
 */
import ProjectTile, { type ProjectCard } from './ProjectTile.astro';

interface Props {
	project: ProjectCard;
}
const { project } = Astro.props;
---

<nav class="mt-16 lg:mt-24" aria-labelledby="next-project">
	<h2 id="next-project" class="type-h2 px-[14px] text-lime lg:px-gutter">Next project</h2>
	<div class="mt-5 px-[14px] lg:mt-8 lg:px-0">
		<ProjectTile project={project} variant="wide" infoFirst />
	</div>
</nav>
