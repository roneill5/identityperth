---
/**
 * Site chrome. On desktop (1024 and up) a fixed left column: logo, primary
 * nav 36.5% down, and a bottom row with the menu button and the weather and
 * clock widgets. On phones and tablets the header is a plain 88px strip
 * with the logo that scrolls away with the page, and a fixed 45px bar along
 * the bottom carries the Menu pill and the widgets (the pattern from Forth
 * and Back's phone layout). Both live outside the Swup container so they
 * never re-render between pages; app.ts keeps the active link in sync.
 * Hovering the ID mark unfolds IDENTITY one letter at a time.
 */
import IdMark from '../assets/brand/id-mark.svg';
import EntityLetters from '../assets/brand/entity-letters.svg';
import SidebarWidgets from './SidebarWidgets.astro';
import { NAV, isActive } from '../lib/site';

interface Props {
	pathname: string;
}
const { pathname } = Astro.props;
---

<header
	class="relative z-40 flex h-[88px] items-center px-[14px] lg:fixed lg:inset-y-0 lg:left-0 lg:h-auto lg:w-(--sidebar-w) lg:flex-col lg:items-start lg:justify-between lg:px-gutter lg:py-gutter"
	data-sidebar
>
	<a href="/" class="logo relative z-50 block h-[60px] text-lime lg:h-[clamp(64px,6.9vw,99px)]" aria-label="Identity, home" data-logo>
		<span class="logo__inner relative block h-full">
			<IdMark class="h-full w-auto" aria-hidden="true" />
			<span class="logo__entity pointer-events-none absolute left-full top-0 flex h-full items-center" aria-hidden="true">
				<span class="h-full aspect-[21/99]"></span>
				<EntityLetters class="h-full w-auto" />
			</span>
		</span>
	</a>

	<nav class="hidden lg:absolute lg:left-gutter lg:top-[36.5%] lg:block" aria-label="Primary">
		<ul class="type-nav">
			{NAV.map((item) => (
				<li>
					<a
						href={item.href}
						class="nav-link inline-block text-paper transition-colors duration-200 hover:text-lime aria-[current=page]:text-lime"
						aria-current={isActive(pathname, item.href) ? 'page' : undefined}
						target={item.external ? '_blank' : undefined}
						rel={item.external ? 'noopener' : undefined}
						data-nav-link
					>
						{item.label}
					</a>
				</li>
			))}
		</ul>
	</nav>

	<div class="hidden lg:flex lg:w-full lg:items-end lg:justify-between">
		<button
			type="button"
			class="type-label cursor-pointer text-paper transition-colors duration-200 hover:text-lime"
			data-menu-toggle
			aria-expanded="false"
			aria-controls="menu"
		>
			<span data-menu-label-closed>Menu</span>
			<span data-menu-label-open hidden>Close</span>
		</button>
		<SidebarWidgets />
	</div>
</header>

<!-- Phones and tablets: the bar along the bottom -->
<div class="bottom-bar lg:hidden" data-bottom-bar>
	<button type="button" class="bottom-bar__pill" data-menu-toggle aria-expanded="false" aria-controls="menu">
		<span data-menu-label-closed>Menu</span>
		<span data-menu-label-open hidden>Close</span>
	</button>
	<SidebarWidgets />
</div>
