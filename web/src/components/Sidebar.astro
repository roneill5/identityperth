---
/**
 * Site chrome. On desktop (1024 and up) a fixed left column: logo, primary
 * nav 36.5% down, and the menu button at the bottom. On phones and tablets
 * the header is a slim strip with the logo that scrolls away, and a fixed
 * bar along the bottom carries the Menu pill (the pattern from Forth and
 * Back's phone layout). Both strips keep 13px above and below their contents,
 * and on phones the mark is the height of the menu's IDENTITY lockup and in
 * the same spot, so opening the menu reads as the ID unfolding (Ross, 30 Oct). Both live outside the swapped page so they
 * never re-render between pages; app.ts keeps the active link in sync.
 * Hovering the ID mark unfolds IDENTITY one letter at a time.
 */
import IdMark from '../assets/brand/id-mark.svg';
import { NAV, isActive } from '../lib/site';
import Roundel from './Roundel.astro';

interface Props {
	pathname: string;
}
const { pathname } = Astro.props;
---

<header
	class="relative z-40 flex items-center px-[14px] py-[13px] lg:fixed lg:inset-y-0 lg:left-0 lg:w-(--sidebar-w) lg:flex-col lg:items-start lg:justify-between lg:px-gutter lg:py-gutter"
	data-sidebar
>
	<a href="/" class="logo relative z-50 block h-[min(60px,calc((100vw-110px)*0.181))] text-lime lg:h-[clamp(64px,6.9vw,99px)]" aria-label="Identity, home" data-logo>
		<span class="logo__inner relative block h-full">
			<span class="logo__mark relative block h-full">
				<IdMark class="h-full w-auto" aria-hidden="true" />
			</span>
		</span>
	</a>

	<nav class="hidden lg:absolute lg:left-gutter lg:top-[36.5%] lg:block" aria-label="Primary">
		<ul class="type-nav">
			{NAV.map((item) => (
				<li>
					<a
						href={item.href}
						class="nav-link inline-block text-paper transition-colors duration-200 hover:text-lime aria-[current=page]:text-lime"
						aria-current={isActive(pathname, item.href) ? 'page' : undefined}
						target={item.external ? '_blank' : undefined}
						rel={item.external ? 'noopener' : undefined}
						data-astro-prefetch={item.prefetch ? undefined : 'false'}
						data-nav-link
					>
						{item.label}
					</a>
				</li>
			))}
		</ul>
	</nav>

	<div class="hidden lg:flex lg:w-full lg:items-end lg:justify-between">
		<button
			type="button"
			class="type-label cursor-pointer text-paper transition-colors duration-200 hover:text-lime"
			data-menu-toggle
			aria-expanded="false"
			aria-controls="menu"
		>
			<span data-menu-label-closed>Menu</span>
			<span data-menu-label-open hidden>Close</span>
		</button>
	</div>
</header>

<!-- Phones and tablets: the bar along the bottom -->
<div class="bottom-bar lg:hidden" data-bottom-bar>
	<button type="button" class="bottom-bar__pill" data-menu-toggle aria-expanded="false" aria-controls="menu">
		<span data-menu-label-closed>Menu</span>
		<span data-menu-label-open hidden>Close</span>
	</button>
</div>
