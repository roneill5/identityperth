---
/**
 * Responsive image from a Sanity `figure`. Sanity's image CDN does the
 * hotspot crop; at build time Astro then fetches that file once and writes
 * the srcset widths into dist as WebP, so the site serves its own images
 * from Cloudflare's edge with no request to Sanity. The editors' preview
 * renders on demand and keeps the CDN URLs instead. Either way the LQIP is
 * the blurred placeholder until the real image loads. Works with expanded
 * assets (`asset->{...}`) and with raw references (images inside rich text).
 * With `portraitAspect`, narrow screens get a portrait crop via <picture>.
 * `fill` images are not cropped: CSS covers the box and the hotspot becomes
 * `object-position`, so a tile and the page hero it grows into show the same
 * framing of the same original.
 */
import { getImage } from 'astro:assets';
import { urlFor } from '../sanity/image';

interface ImageAsset {
	_id?: string | null;
	_ref?: string | null;
	url?: string | null;
	metadata?: {
		lqip?: string | null;
		dimensions?: { width?: number | null; height?: number | null; aspectRatio?: number | null } | null;
	} | null;
}

export interface Figure {
	asset?: ImageAsset | null;
	alt?: string | null;
	hotspot?: { x?: number | null; y?: number | null } | null;
	crop?: unknown;
}

interface Props {
	image: Figure;
	/** Width/height ratio to crop to. Omit to keep the image's own ratio. */
	aspect?: number;
	/** Width/height ratio used below 768px instead of `aspect`. */
	portraitAspect?: number;
	/** Fill the positioned parent (absolute inset-0, object-cover). */
	fill?: boolean;
	/** The `sizes` attribute, e.g. "(min-width: 1024px) 50vw, 100vw". */
	sizes?: string;
	widths?: number[];
	loading?: 'lazy' | 'eager';
	fetchpriority?: 'high' | 'low' | 'auto';
	/** This is the page's first picture: add a preload hint so it starts before the stylesheet has arrived. */
	preload?: boolean;
	class?: string;
}

const {
	image,
	aspect,
	portraitAspect,
	fill = false,
	sizes = '100vw',
	widths = [320, 480, 768, 1024, 1440, 1920, 2560],
	loading = 'lazy',
	fetchpriority,
	preload = false,
	class: className,
} = Astro.props;

const asset = image?.asset;
const id = asset?._id ?? asset?._ref ?? null;

/** Sanity asset IDs encode the original size and format: image-<hash>-<w>x<h>-<ext>. */
function dimsFromId(assetId: string | null): { width: number; height: number; aspectRatio?: number | null } | null {
	const match = assetId?.match(/-(\d+)x(\d+)-/);
	return match ? { width: Number(match[1]), height: Number(match[2]) } : null;
}
const sourceFormat = id?.endsWith('-png') ? 'png' : 'jpg';

const dims = asset?.metadata?.dimensions ?? dimsFromId(id);
const naturalRatio =
	dims?.aspectRatio || (dims?.width && dims?.height ? dims.width / dims.height : 1.5);
// A filled box crops in CSS, so the file keeps its own ratio.
const cropTo = fill ? undefined : aspect;
const ratio = cropTo ?? naturalRatio;
const focal = fill && image?.hotspot ? `${Math.round((image.hotspot.x ?? 0.5) * 100)}% ${Math.round((image.hotspot.y ?? 0.5) * 100)}%` : null;

/** A CDN URL at a width, cropped around the hotspot when a ratio is given. */
function cdn(width: number, cropTo: number | undefined, quality: number, format?: 'jpg' | 'png') {
	let builder = urlFor(image).width(width).quality(quality);
	if (cropTo) builder = builder.height(Math.round(width / cropTo)).fit('crop');
	if (format) builder = builder.format(format);
	return builder.url();
}

const maxWidth = dims?.width ?? widths[widths.length - 1];
const usable = widths.filter((w) => w <= maxWidth);
const list = usable.length ? usable : [Math.min(maxWidth, widths[0])];
const fallbackWidth = list[Math.min(list.length - 1, 3)];
const width = fallbackWidth;
const height = Math.round(fallbackWidth / ratio);

// Pages built ahead of time host the files themselves; the preview keeps the CDN.
const local = !Astro.locals.preview;

/** `src` and `srcset` for one crop: Astro's copies when building, Sanity's URLs otherwise. */
async function variant(crop: number | undefined) {
	if (!local) {
		return { src: cdn(fallbackWidth, crop, 80), srcset: list.map((w) => `${cdn(w, crop, 80)} ${w}w`).join(', ') };
	}
	const sourceWidth = list[list.length - 1];
	const built = await getImage({
		src: cdn(sourceWidth, crop, 90, sourceFormat),
		width: sourceWidth,
		height: Math.round(sourceWidth / (crop ?? naturalRatio)),
		widths: list,
		sizes,
		format: 'webp',
		quality: 80,
	});
	return { src: built.src, srcset: built.srcSet.attribute };
}

// Only build URLs when there is an asset; an image whose upload failed renders nothing.
const main = id ? await variant(cropTo) : null;
const portrait = id && portraitAspect && !fill ? await variant(portraitAspect) : null;
const lqip = asset?.metadata?.lqip ?? undefined;
const imgClass = [
	'block max-w-full bg-cover bg-center object-cover',
	fill ? 'absolute inset-0 h-full w-full' : 'h-auto w-full',
	// Below 768px the box keeps the portrait crop's shape from the start, so nothing shifts when that source arrives.
	portrait && 'max-md:aspect-(--ar-p)',
	className,
];
const style = [lqip ? `background-image:url(${lqip})` : null, focal ? `object-position:${focal};background-position:${focal}` : null, portrait ? `--ar-p:${portraitAspect}` : null].filter(Boolean).join(';') || undefined;
---

{main && preload && !portrait && <link rel="preload" as="image" imagesrcset={main.srcset} imagesizes={sizes} fetchpriority={fetchpriority} />}
{main ? (
	portrait ? (
		<picture>
			<source media="(max-width: 767px)" srcset={portrait.srcset} sizes={sizes} />
			<img
				src={main.src}
				srcset={main.srcset}
				sizes={sizes}
				width={width}
				height={height}
				alt={image.alt ?? ''}
				loading={loading}
				decoding="async"
				fetchpriority={fetchpriority}
				draggable="false"
				class:list={imgClass}
				style={style}
				data-img
			/>
		</picture>
	) : (
		<img
			src={main.src}
			srcset={main.srcset}
			sizes={sizes}
			width={width}
			height={height}
			alt={image.alt ?? ''}
			loading={loading}
			decoding="async"
			fetchpriority={fetchpriority}
			draggable="false"
			class:list={imgClass}
			style={style}
			data-img
		/>
	)
) : null}
