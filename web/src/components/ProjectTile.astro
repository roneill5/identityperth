---
/**
 * A project tile from the Projects page design (Figma page 7): the cover
 * (an image or a silent video loop), and on hover a slate wash (#64737a at
 * 70%) with, bottom left, the title, then the work done (the services, e.g.
 * Brand, Campaign, Web); the description came off on 28 Oct (Ross). The
 * cover is left alone. With
 * `infoFirst` (the next-project card) it works the other way round, on
 * devices with a mouse: at rest the cover is black and white under the wash
 * with the text showing; hovering clears the wash, brings the colour back
 * and keeps the text over a soft dark fade (Ross, 26 Oct). On phones and tablets
 * there is no hover, so the title and services sit in a caption row under
 * the cover instead, the same words as the hover (Ross, 30 Oct). `data-flip` lets transitions.ts
 * grow the cover into the project page hero on click.
 */
import Media, { type MediaData } from './Media.astro';

export interface ProjectCard {
	_id: string;
	title: string | null;
	slug: string | null;
	tagline?: string | null;
	summary?: string | null;
	client?: { name?: string | null } | null;
	services?: ({ title?: string | null } | null)[] | null;
	cover?: MediaData | null;
}

interface Props {
	project: ProjectCard;
	variant?: 'wide' | 'square';
	/** Text and wash showing at rest over a black and white cover; colour on hover. */
	infoFirst?: boolean;
	loading?: 'lazy' | 'eager';
	class?: string;
}

const { project, variant = 'square', infoFirst = false, loading = 'lazy', class: className } = Astro.props;
const mediaClass = ['tile__media', infoFirst && 'pointer-fine:grayscale transition-[filter] duration-700 ease-out group-hover:grayscale-0 group-focus-visible:grayscale-0'].filter(Boolean).join(' ');
const show = 'opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100';
const hide = 'opacity-100 group-hover:opacity-0 group-focus-visible:opacity-0';
const wash = infoFirst ? hide : show;
const reveal = infoFirst ? 'opacity-100' : show;
const aspect = variant === 'wide' ? 1025 / 475 : 1;
const sizes = variant === 'wide' ? '(min-width: 1024px) 71vw, 100vw' : '(min-width: 1024px) 35vw, (min-width: 768px) 50vw, 100vw';
const services = (project.services ?? []).map((s) => s?.title).filter((t): t is string => Boolean(t));
---

<a href={`/projects/${project.slug}/`} class:list={['tile group relative block', className]} data-flip data-warm-sizes="(min-width: 1024px) 71vw, 100vw">
	<div class:list={['relative overflow-hidden bg-ink', variant === 'wide' ? 'aspect-square md:aspect-[1025/475]' : 'aspect-square']} data-flip-box>
		{project.cover && <Media media={project.cover} aspect={aspect} fill sizes={sizes} loading={loading} fetchpriority={loading === 'eager' ? 'high' : undefined} preload={loading === 'eager'} file class={mediaClass} />}
		<span class:list={['pointer-events-none absolute inset-0 hidden bg-slate/70 transition-opacity duration-500 lg:block', wash]} aria-hidden="true"></span>
		{infoFirst && <span class:list={['pointer-events-none absolute inset-x-0 bottom-0 hidden h-3/5 bg-linear-to-t from-ink/75 via-ink/25 to-transparent transition-opacity duration-500 lg:block', show]} aria-hidden="true"></span>}

		<div class="absolute inset-0 hidden flex-col justify-end px-[22px] pb-[18px] lg:flex">
			<div class:list={['max-w-[300px] transition-opacity duration-300 lg:max-w-[440px]', reveal]}>
				<p class="type-h3 text-paper">{project.title}</p>
				{services.length > 0 && <p class="font-display mt-3 text-[11px] uppercase leading-[1.4] tracking-[1px] text-paper lg:text-[13px] lg:tracking-[1.2px]">{services.join(', ')}</p>}
			</div>
		</div>
	</div>

	<div class="pt-[10px] pb-[22px] lg:hidden">
		<p class="type-h3 text-paper">{project.title}</p>
		{services.length > 0 && <p class="font-display mt-1.5 text-[13px] uppercase leading-[1.4] tracking-[1.2px] text-paper/80">{services.join(', ')}</p>}
	</div>
</a>
