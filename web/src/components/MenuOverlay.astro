---
import { safeHref } from '../lib/site';
/**
 * Full-screen menu from the design (Figma page 2): the IDENTITY lockup
 * top-left in the same spot and size as the sidebar's ID mark (so opening
 * the menu reads as the ID unfolding into the word), tagline top-right, the
 * four sections as a serif row 45% down, the contact column on the right,
 * "Close" bottom-left (where the sidebar's Menu sits) and a close ring
 * top-right. On phones it sits above the
 * bottom bar: full-width wordmark, tagline, then a two-column block with the
 * links left and the contact details right, centred in the leftover space
 * (Forth and Back's phone menu), spaced to fit an iPhone's Safari viewport
 * without scrolling (Ross, 30 Oct). Hidden until menu.ts opens it.
 */
import IdMark from '../assets/brand/id-mark.svg';
import EntityLetters from '../assets/brand/entity-letters.svg';
import Roundel from './Roundel.astro';
import RingIcon from './icons/RingIcon.astro';
import { NAV, PRIVACY_LINKED } from '../lib/site';
import { stegaClean } from '@sanity/client/stega';

interface Settings {
	tagline?: string | null;
	menuText?: string | null;
	email?: string | null;
	careersEmail?: string | null;
	phone?: string | null;
	address?: string | null;
	socials?: { _key: string; label?: string | null; url?: string | null }[] | null;
}

interface Props {
	settings: Settings | null;
}
const { settings } = Astro.props;
const addressLines = settings?.address?.split('\n').filter(Boolean) ?? [];
---

<div
	id="menu"
	class="invisible fixed inset-0 z-50 bg-ink opacity-0"
	data-menu
	aria-hidden="true"
	role="dialog"
	aria-modal="true"
	aria-label="Menu"
>
	<div class="relative flex h-full flex-col overflow-y-auto overflow-x-hidden p-[14px] pt-[max(13px,env(safe-area-inset-top))] pb-3 lg:block lg:overflow-hidden lg:p-gutter">
		<a href="/" class="inline-flex w-full items-start gap-[10px] text-lime lg:w-fit lg:gap-[13px]" aria-label="Identity, home" data-menu-link data-menu-brand>
			<span class="logo__inner relative block h-[calc((100vw-110px)*0.181)] lg:h-[clamp(64px,6.9vw,99px)]" aria-hidden="true" data-menu-lockup>
				<span class="logo__mark inline-flex h-full items-center">
					<IdMark class="h-full w-auto" />
					<span class="logo__entity relative inline-flex h-full items-center">
						<span class="h-full aspect-[21/99]"></span>
						<EntityLetters class="h-full w-auto" />
					</span>
				</span>
			</span>
			<Roundel class="logo__roundel mt-1 h-5 w-5 text-slate lg:mt-0 lg:h-[2.2vw] lg:w-[2.2vw] lg:-translate-y-1/2" />
		</a>

		{settings?.tagline && <p class="type-display mt-3 max-w-[12em] text-[16px] leading-[1.15] text-paper lg:hidden">{settings.tagline}</p>}

		<div class="my-auto grid grid-cols-[auto_minmax(0,1fr)] gap-x-6 py-3 lg:contents">
		<nav class="lg:absolute lg:left-gutter lg:top-[45%]" aria-label="Menu">
			<ul class="type-menu flex flex-col gap-y-2 text-[36px] leading-[1.2] lg:flex-row lg:flex-wrap lg:gap-x-[0.54em] lg:gap-y-0 lg:text-[clamp(2.25rem,3.6vw,4.75rem)]">
				{NAV.map((item) => (
					<li class="overflow-hidden pb-[0.24em] -mb-[0.24em]">
						{/* Fetched when the menu first opens (menu.ts), not at page load: the closed overlay only looks hidden to the router's viewport prefetch. */}
						<a
							href={item.href}
							class="inline-block text-paper transition-colors duration-200 hover:text-lime"
							target={item.external ? '_blank' : undefined}
							rel={item.external ? 'noopener' : undefined}
							data-astro-prefetch="false"
							data-menu-prefetch={item.prefetch ? '' : undefined}
							data-menu-item
							data-menu-link
						>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="flex min-w-0 flex-col lg:absolute lg:top-gutter lg:right-gutter lg:bottom-gutter lg:w-[31vw] lg:gap-10 lg:pr-12" data-menu-contact>
			{settings?.tagline && <p class="type-display hidden max-w-[11em] text-paper lg:-mt-[5px] lg:block">{settings.tagline}</p>}

			<div class="flex flex-col gap-2 text-[15px] leading-[1.3] [overflow-wrap:anywhere] lg:absolute lg:top-[27.5vh] lg:left-0 lg:right-12 lg:gap-7 lg:text-[16.5px] lg:leading-[1.3]">
				{settings?.menuText && <p class="max-w-[18em]">{settings.menuText}</p>}

				{settings?.email && (
					<p>
						<span class="block text-lime">enquiries:</span>
						<a href={`mailto:${stegaClean(settings.email)}`} class="text-link inline-block py-0.5 hover:text-lime lg:py-0">{settings.email}</a>
					</p>
				)}
				{settings?.careersEmail && (
					<p>
						<span class="block text-lime">join us:</span>
						<a href={`mailto:${stegaClean(settings.careersEmail)}`} data-track="careers_email" class="text-link inline-block py-0.5 hover:text-lime lg:py-0">{settings.careersEmail}</a>
					</p>
				)}
				{settings?.phone && (
					<p>
						<span class="block text-lime">phone:</span>
						<a href={`tel:${stegaClean(settings.phone).replace(/\s+/g, '')}`} class="text-link inline-block py-0.5 hover:text-lime lg:py-0">{settings.phone}</a>
					</p>
				)}
				{settings?.socials?.length ? (
					<div>
						<span class="block text-lime">socials:</span>
						<ul class="leading-[1.6]">
							{settings.socials.map((s) => (
								<li>
									<a href={safeHref(s.url) ?? '#'} class="text-link inline-block py-0.5 hover:text-lime lg:py-0" rel="noopener" target="_blank">{s.label}</a>
								</li>
							))}
						</ul>
					</div>
				) : null}
				{addressLines.length ? (
					<p>
						<span class="block text-lime">address:</span>
						{addressLines.map((line, i) => (
							<>
								{line}
								{i < addressLines.length - 1 && <br />}
							</>
						))}
					</p>
				) : null}
				{PRIVACY_LINKED && (
					<p class="text-[13px] text-paper/60 lg:text-[14px]">
						<a href="/privacy" class="text-link inline-block py-0.5 hover:text-lime lg:py-0" data-astro-prefetch="false" data-menu-prefetch>Privacy policy</a>
					</p>
				)}
			</div>
		</div>
		</div>

		<button
			type="button"
			class="type-label mt-auto hidden w-fit cursor-pointer text-left text-paper transition-colors hover:text-lime lg:absolute lg:left-gutter lg:bottom-gutter lg:block"
			data-menu-toggle
			aria-label="Close menu"
		>
			Close
		</button>

		<button
			type="button"
			class="absolute right-[8px] top-[max(14px,env(safe-area-inset-top))] z-10 grid h-[48px] w-[48px] cursor-pointer place-items-center text-paper transition-colors hover:text-lime lg:right-gutter lg:top-gutter lg:h-auto lg:w-auto"
			data-menu-toggle
			aria-label="Close menu"
		>
			<RingIcon kind="close" class="h-8 w-8 lg:h-6 lg:w-6" />
		</button>
	</div>
</div>

{/* Editors' preview: the Studio only refreshes for documents whose text it can see, and the closed menu is
    visibility-hidden, so a Site settings edit went unnoticed (4 Nov). One always-visible, invisible pixel of
    its text keeps the document registered; preview.ts then reloads for it. */}
{Astro.locals.preview && settings?.menuText && (
	<span class="pointer-events-none fixed bottom-0 left-0 h-px w-px overflow-hidden opacity-0" aria-hidden="true">{settings.menuText}</span>
)}
