---
/**
 * The instruments beside the menu button: weather in Joondalup (outline
 * icon, degrees) and an analogue clock on Perth time. Drawn in paper on
 * ink with a lime second hand; weather.ts fills them in. One instance:
 * below the desktop breakpoint CSS trims it to the icon and temperature.
 */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['wx', className]}>
	<div class="wx__item opacity-0 transition-opacity duration-700 [&.is-ready]:opacity-100" data-weather>
		<span class="wx__icon" data-weather-icon aria-hidden="true"></span>
		<span class="wx__text">
			<span class="wx__big" data-weather-temp>--°</span>
			<span class="wx__label">Joondalup</span>
		</span>
	</div>

	<div class="wx__item" data-clock>
		<svg class="wx__clock" viewBox="0 0 32 32" aria-hidden="true">
			<circle cx="16" cy="16" r="13" />
			<path d="M16 5.5v2.5M26.5 16H24M16 26.5V24M5.5 16H8" />
			<path d="M16 16V10" stroke-width="2.3" data-hand="hour" />
			<path d="M16 16V7.5" stroke-width="1.9" data-hand="minute" />
			<path d="M16 18.5V7" class="wx__second" data-hand="second" />
			<circle cx="16" cy="16" r="1.8" class="wx__pin" />
		</svg>
		<span class="wx__text">
			<span class="wx__big" data-clock-text>--:--</span>
			<span class="wx__label">Perth</span>
		</span>
	</div>
</div>
