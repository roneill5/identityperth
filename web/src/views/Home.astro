---
/**
 * Home: the splash. The hero fills the viewport (the showreel once it
 * exists, the image until then) and the whole thing links to Projects;
 * scrolling or clicking slides the page up into the work
 * (Forth & Back behaviour, Figma page 6).
 */
import Base from '../layouts/Base.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import Ticker from '../components/Ticker.astro';
import Wordmark from '../components/Wordmark.astro';
import { client } from '../sanity/client';
import { stegaClean } from '@sanity/client/stega';
import { HOME_QUERY, PROJECTS_QUERY } from '../sanity/queries';
import { load } from '../sanity/fetch';
import Media from '../components/Media.astro';

/** The draft client on /preview, the build-time one everywhere else. */
const sanity = Astro.locals.sanity ?? client;

const home = await load(sanity, HOME_QUERY);
// The first row of Projects, warmed from here at idle so the landing is already painted (page.ts, data-warm-idle).
const firstTiles = (await load(sanity, PROJECTS_QUERY)).slice(0, 3);
const video = home?.heroVideo ? { streamId: stegaClean(home.heroVideo) } : null;
// The portrait (9:16) cut, for screens taller than they are wide. Each cut loads only while it is the one displayed.
// On desktop both play from their MP4 file, so the showreel keeps playing while the page slides away to Projects
// (transitions.ts). Phones and tablets stream adaptively instead (page.ts): the 32 MB file stalled on anything
// slower than about 4 Mbps (Ross, 3 Nov).
const tallVideo = video && home?.heroVideoMobile ? { streamId: stegaClean(home.heroVideoMobile) } : null;
const phrases = (home?.ticker ?? []).filter((p): p is string => Boolean(p));
// The showreel covers the space above the ticker at every window shape, like
// the still image, cropped from the centre: a window wider than 16:9 loses
// the same amount off the top and the bottom, a narrower one off the sides
// (Ross, 28 Oct; the full-width box before it left ink bands above and below
// on 16:10 screens and tablets). So the cut must keep its logos and titles
// inside a safe zone: docs/showreel-safe-zones/ has the overlays for the
// designer (Ross, 30 Oct: corner logos 32px from the frame edge were cut on
// nearly every laptop). A portrait cut, when there is one, takes over on
// portrait screens and covers the same space.
const coverBox = ['absolute inset-x-0 top-0', phrases.length ? 'bottom-(--ticker-h)' : 'bottom-0'];
const videoBox = [...coverBox, tallVideo && 'portrait:hidden'];
const tallBox = [...coverBox, 'landscape:hidden'];
---

<Base page="splash" metaTitle={home?.seo?.title} description={home?.seo?.description}>
	<section class="relative flex h-dvh flex-col" data-hero data-splash>
		<h1 class="sr-only">Identity Perth. Brand, creative and digital agency.</h1>
		<div class="relative flex-1 overflow-hidden bg-ink">
			{video ? (
				<>
					<div class:list={videoBox}>
						<VideoEmbed video={video} fill loading="eager" fetchpriority="high" preload preloadMedia={tallVideo ? '(orientation: landscape)' : undefined} file adaptive />
					</div>
					{tallVideo ? (
						<div class:list={tallBox}>
							<VideoEmbed video={tallVideo} fill loading="eager" fetchpriority="high" preload preloadMedia="(orientation: portrait)" file adaptive />
						</div>
					) : null}
					<script is:inline>
						// Phones and tablets stream the showreel (page.ts), and its player only starts once the whole page
						// has loaded. This runs while the page is still parsing: it fetches the playlists and the first
						// 4 s of the rendition the player will start on (the sharpest that fits, no sharper than 480p, or
						// 360p under 2 Mbps where the browser says: as page.ts chooses), so the player finds them in the
						// cache. page.ts waits for `__reel` (4 Nov). iPhones have no MediaSource and play the stream with
						// their own player, which fetches its own pieces (6 Nov).
						(() => {
							if (matchMedia('(min-width: 64rem)').matches || !('MediaSource' in window)) return;
							const video = [...document.querySelectorAll('video[data-adaptive][data-hls]')].find((v) => v.getClientRects().length);
							if (!video) return;
							const src = video.dataset.hls;
							const text = (url) => fetch(url).then((r) => (r.ok ? r.text() : Promise.reject(r.status)));
							const slow = ((navigator.connection || {}).downlink || Infinity) < 2;
							const cap = Math.min(slow ? 640 : 854, Math.max(innerWidth, innerHeight) * (devicePixelRatio || 1) * 1.2);
							const ready = text(src).then(async (master) => {
								const lines = master.split('\n');
								let best = null;
								lines.forEach((line, n) => {
									const res = line.startsWith('#EXT-X-STREAM-INF') && /RESOLUTION=(\d+)x(\d+)/.exec(line);
									if (!res) return;
									const size = Math.max(Number(res[1]), Number(res[2]));
									const bandwidth = Number((/[:,]BANDWIDTH=(\d+)/.exec(line) || [])[1]);
									if (size <= cap && (!best || bandwidth > best.bandwidth)) best = { bandwidth, uri: lines[n + 1].trim() };
								});
								if (!best) return;
								const level = new URL(best.uri, src).href;
								const playlist = await text(level);
								const init = (/#EXT-X-MAP:URI="([^"]+)"/.exec(playlist) || [])[1];
								const first = playlist.split('\n').find((l) => l.trim() && !l.startsWith('#'));
								await Promise.all([init, first].filter(Boolean).map((u) => fetch(new URL(u.trim(), level).href).then((r) => r.arrayBuffer())));
							});
							window.__reel = { src, ready: ready.catch(() => {}) };
						})();
					</script>
				</>
			) : (
				<div class="absolute inset-0 flex items-center justify-center text-lime">
					<Wordmark class="h-[8vw]" />
				</div>
			)}
			<a href="/projects/" class="absolute inset-0 z-10" aria-label="See our projects" data-advance-link></a>
		</div>
	</section>

	{firstTiles.length ? (
		<div hidden data-warm-idle>
			{firstTiles.map((p, i) =>
				p.cover ? <Media media={p.cover} aspect={i === 0 ? 1025 / 475 : 1} fill sizes={i === 0 ? '(min-width: 1024px) 71vw, 100vw' : '(min-width: 1024px) 35vw, (min-width: 768px) 50vw, 100vw'} loading="lazy" file /> : null,
			)}
		</div>
	) : null}

	{phrases.length ? (
		<div slot="ticker" class="fixed left-0 z-20 h-dvh w-full bg-ink" style="top:calc(100dvh - var(--ticker-h))" data-ticker-screen>
			<Ticker phrases={phrases} />
		</div>
	) : null}
</Base>
