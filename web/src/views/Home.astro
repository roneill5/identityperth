---
/**
 * Home: the splash. The hero fills the viewport (the showreel once it
 * exists, the image until then) and the whole thing links to Projects;
 * scrolling or clicking goes there through the ticker curtain
 * (Forth & Back behaviour, Figma page 6).
 */
import Base from '../layouts/Base.astro';
import SanityImage from '../components/SanityImage.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import Ticker from '../components/Ticker.astro';
import Wordmark from '../components/Wordmark.astro';
import { client } from '../sanity/client';
import { stegaClean } from '@sanity/client/stega';
import { HOME_QUERY } from '../sanity/queries';

/** The draft client on /preview, the build-time one everywhere else. */
const sanity = Astro.locals.sanity ?? client;

const home = await sanity.fetch(HOME_QUERY);
const video = home?.heroVideo ? { streamId: stegaClean(home.heroVideo), playback: 'loop' as const } : null;
const phrases = (home?.ticker ?? []).filter((p): p is string => Boolean(p));
---

<Base page="splash" description={home?.seo?.description} image={home?.seo?.image?.asset?.url}>
	<section class="relative flex h-dvh flex-col" data-hero data-splash>
		<div class="relative flex-1 overflow-hidden bg-ink">
			{video ? (
				<VideoEmbed video={video} fill loading="eager" />
			) : home?.heroImage?.asset ? (
				<SanityImage image={home.heroImage} fill sizes="100vw" loading="eager" fetchpriority="high" />
			) : (
				<div class="absolute inset-0 flex items-center justify-center text-lime">
					<Wordmark class="h-[8vw]" />
				</div>
			)}
			<a href="/projects" class="absolute inset-0 z-10" aria-label="See our projects" data-advance-link data-swup-preload></a>
		</div>
	</section>

	{phrases.length ? (
		<div slot="ticker" class="fixed left-0 z-20 h-dvh w-full bg-ink" style="top:calc(100dvh - var(--ticker-h))" data-ticker-screen>
			<Ticker phrases={phrases} />
		</div>
	) : null}
</Base>
