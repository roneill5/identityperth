---
/**
 * Studio: a column of photographs beside a sticky accordion (About, Services,
 * Team, Clients, Contact). The column follows the accordion's order, and on
 * desktop scrolling it opens the matching section (scripts/studio.ts); the
 * About heading cycles through its phrases (scripts/cycle.ts). Measurements
 * are from Figma pages 3 to 5 at 1440 wide. On phones the photos become a
 * swipeable strip above the accordion so the page fits one screen; opening
 * a section folds the strip away (Forth and Back's phone pattern).
 */
import Base from '../layouts/Base.astro';
import SanityImage, { type Figure } from '../components/SanityImage.astro';
import RichText from '../components/RichText.astro';
import RingIcon from '../components/icons/RingIcon.astro';
import { client } from '../sanity/client';
import { STUDIO_QUERY } from '../sanity/queries';
import { getSettings, load } from '../sanity/fetch';
import { paragraphs } from '../lib/text';
import { safeHref } from '../lib/site';
import { stegaClean } from '@sanity/client/stega';

/** The draft client on /preview, the build-time one everywhere else. */
const sanity = Astro.locals.sanity ?? client;

const [{ page, services, team }, settings] = await Promise.all([
	load(sanity, STUDIO_QUERY),
	getSettings(sanity),
]);
const addressLines = settings?.address?.split('\n').filter(Boolean) ?? [];

const headings = [page?.aboutHeading, ...(page?.aboutHeadings ?? [])].filter(
	(h, i, all): h is string => Boolean(h) && all.indexOf(h) === i,
);

interface ColumnImage {
	image: Figure;
	/** Which set the photo belongs to: the studio's, or the portraits shown while Team is open. */
	group: 'about' | 'team';
	aspect: number;
	mono?: boolean;
	alt?: string;
	/** On a portrait, the person it opens: `team:<id>` (scripts/studio.ts). */
	opens?: string;
}
// The column is the studio's photos whatever is open, except Team, which
// shows the portraits instead (Ross, 21 Oct); the photos on services and on
// the Clients and Contact sections stay in the CMS unused. Studio photos
// and portraits both crop to 5:7 (528 x 740 in the design; the portraits
// were 528 x 612 until Seth supplied them at 5:7 on 29 Oct).
const column: ColumnImage[] = [
	...(page?.images ?? []).map((image) => ({ image, group: 'about' as const, aspect: 5 / 7 })),
	...team.flatMap((m) =>
		m.portrait?.asset ? [{ image: m.portrait, group: 'team' as const, aspect: 5 / 7, mono: true, alt: m.name ?? undefined, opens: `team:${m._id}` }] : [],
	),
];

const summaryClass = 'type-accordion flex items-center justify-between border-b border-slate py-3 lg:pt-2 lg:pb-[7px]';
const sections = [
	{ id: 'about', label: 'About' },
	{ id: 'services', label: 'Services' },
	{ id: 'team', label: 'Team' },
	{ id: 'clients', label: 'Clients' },
	{ id: 'contact', label: 'Contact' },
] as const;
---

<Base title="Studio" metaTitle={page?.seo?.title} description={page?.seo?.description ?? 'Identity is a connected strategic and creative partner in Perth, Western Australia.'}>
	<div class="lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,calc(31.02vw+var(--spacing-gutter)))] lg:gap-x-gutter" data-studio>
		<div
			class="studio-strip flex h-[calc(100dvh-370px)] min-h-[220px] gap-[10px] overflow-x-auto px-[14px] lg:order-1 lg:h-auto lg:min-h-0 lg:flex-col lg:gap-4 lg:overflow-visible lg:px-0 lg:pt-0"
			data-studio-images
		>
			{column.map((item, i) => (
				<div class:list={['relative h-full shrink-0 overflow-hidden bg-ink lg:h-auto lg:w-auto lg:shrink', item.mono && 'grayscale', item.group !== 'about' && 'hidden']} style={`aspect-ratio:${item.aspect}`} data-group={item.group} data-opens={item.opens}>
					<SanityImage image={{ ...item.image, alt: item.image.alt ?? item.alt ?? null }} aspect={item.aspect} fill sizes="(min-width: 1024px) 37vw, 100vw" loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} preload={i === 0} />
				</div>
			))}
		</div>

		<div class="px-[14px] pt-[15px] pb-12 lg:sticky lg:top-0 lg:order-2 lg:self-start lg:px-0 lg:pt-5 lg:pr-gutter lg:pb-gutter" data-accordion>
			<h1 class="sr-only">Studio</h1>

			<details class="accordion" data-section="about" open>
				<summary class={summaryClass}>
					<span>{sections[0].label}</span>
					<RingIcon kind="plus" class="accordion__icon h-5 w-5 lg:h-[14.4px] lg:w-[14.4px]" />
				</summary>
				<div class="pt-[19px] pb-[5px]">
					{headings.length ? (
						<h2 class="type-h2 cycle mb-4" data-cycle>
							{headings.map((h, i) => (
								<span class="cycle__phrase" data-phrase aria-hidden={i > 0 ? 'true' : undefined}>{h}</span>
							))}
						</h2>
					) : null}
					<RichText value={page?.aboutBody} class="type-small max-w-[400px] leading-[1.45] [&_p+p]:mt-4 lg:max-w-[500px] lg:text-[16.5px] lg:leading-[1.35] lg:[&_p+p]:mt-5" />
					{page?.aboutHighlights?.length ? (
						<ul class="type-small mt-4 leading-[1.45] text-lime lg:mt-5 lg:text-[16.5px] lg:leading-[1.35]">
							{page.aboutHighlights.map((line) => (
								<li>{line}</li>
							))}
						</ul>
					) : null}
				</div>
			</details>

			<details class="accordion" data-section="services">
				<summary class={summaryClass}>
					<span>{sections[1].label}</span>
					<RingIcon kind="plus" class="accordion__icon h-5 w-5 lg:h-[14.4px] lg:w-[14.4px]" />
				</summary>
				<ul class="pt-[14px]">
					{services.map((service) => (
						<li>
							<details class="accordion group" data-item={`services:${service._id}`}>
								<summary class="type-h2 py-2 text-paper transition-colors duration-300 group-open:text-lime hover:text-lime lg:py-[4.75px]">{service.title}</summary>
								{/* One panel: accordion.ts slides the single element after the summary, so loose paragraphs left
								    the second one snapping in and out while the first slid (Ross, 5 Nov). */}
								<div>
									{paragraphs(service.description).map((p, i) => (
										<p class:list={['type-small max-w-[414px] pb-1 leading-[1.45] text-paper lg:max-w-[500px] lg:text-[16.5px] lg:leading-[1.35]', i === 0 ? 'pt-1' : 'pt-2']}>{p}</p>
									))}
								</div>
							</details>
						</li>
					))}
				</ul>
			</details>

			<details class="accordion" data-section="team">
				<summary class={summaryClass}>
					<span>{sections[2].label}</span>
					<RingIcon kind="plus" class="accordion__icon h-5 w-5 lg:h-[14.4px] lg:w-[14.4px]" />
				</summary>
				<ul class="pt-[15px] pb-3">
					{team.map((member) => (
						<li>
							<details class="accordion group" data-item={`team:${member._id}`}>
								<summary class="type-h2 py-2 text-paper transition-colors duration-300 group-open:text-lime hover:text-lime lg:py-[4.75px]">{member.name}</summary>
								<div class="pb-2">
									{member.role && <p class="font-display -mt-0.5 text-[17px] uppercase leading-[21px] tracking-[1px] text-lime">{member.role}</p>}
									{member.bio && <p class="type-small mt-2.5 max-w-[410px] leading-[1.45] text-paper lg:max-w-[500px] lg:text-[16.5px] lg:leading-[1.35]">{member.bio}</p>}
									{member.portrait?.asset && (
										<div class="mt-4 max-w-[240px] grayscale lg:hidden">
											<SanityImage image={member.portrait} aspect={5 / 7} sizes="240px" />
										</div>
									)}
								</div>
							</details>
						</li>
					))}
				</ul>
			</details>

			<details class="accordion" data-section="clients">
				<summary class={summaryClass}>
					<span>{sections[3].label}</span>
					<RingIcon kind="plus" class="accordion__icon h-5 w-5 lg:h-[14.4px] lg:w-[14.4px]" />
				</summary>
				<div class="pt-[15px] pb-3">
					{page?.clientsIntro && <p class="type-h3 mb-4 max-w-[400px] lg:max-w-[500px]">{page.clientsIntro}</p>}
					<ul class="type-small leading-[1.45] lg:text-[16.5px] lg:leading-[1.35]">
						{(page?.clients ?? []).map((name) => (
							<li class="py-0.5 text-paper">{name}</li>
						))}
					</ul>
				</div>
			</details>

			<details class="accordion" data-section="contact" id="contact">
				<summary class={summaryClass}>
					<span>{sections[4].label}</span>
					<RingIcon kind="plus" class="accordion__icon h-5 w-5 lg:h-[14.4px] lg:w-[14.4px]" />
				</summary>
				<div class="type-body flex flex-col gap-5 pt-[15px] pb-3">
					{settings?.menuText && <p class="max-w-[22em]">{settings.menuText}</p>}
					{settings?.email && (
						<p>
							<span class="block text-lime">enquiries:</span>
							<a href={`mailto:${stegaClean(settings.email)}`} class="text-link inline-block py-1 hover:text-lime lg:py-0">{settings.email}</a>
						</p>
					)}
					{settings?.careersEmail && (
						<p>
							<span class="block text-lime">join us:</span>
							<a href={`mailto:${stegaClean(settings.careersEmail)}`} data-track="careers_email" class="text-link inline-block py-1 hover:text-lime lg:py-0">{settings.careersEmail}</a>
						</p>
					)}
					{settings?.phone && (
						<p>
							<span class="block text-lime">phone:</span>
							<a href={`tel:${stegaClean(settings.phone).replace(/\s+/g, '')}`} class="text-link inline-block py-1 hover:text-lime lg:py-0">{settings.phone}</a>
						</p>
					)}
					{settings?.socials?.length ? (
						<div>
							<span class="block text-lime">socials:</span>
							<ul class="leading-[1.6]">
								{settings.socials.map((s) => (
									<li>
										<a href={safeHref(s.url) ?? '#'} class="text-link inline-block py-1 hover:text-lime lg:py-0" rel="noopener" target="_blank">{s.label}</a>
									</li>
								))}
							</ul>
						</div>
					) : null}
					{addressLines.length ? (
						<p>
							<span class="block text-lime">address:</span>
							{addressLines.map((line, i) => (
								<>
									{line}
									{i < addressLines.length - 1 && <br />}
								</>
							))}
						</p>
					) : null}
				</div>
			</details>
		</div>
	</div>
</Base>
