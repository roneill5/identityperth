---
/**
 * The editors' preview: the same views as the public pages, rendered on
 * request with draft content. The middleware only lets requests through
 * with the preview cookie the Studio sets via /preview/enable.
 */
import Home from '../../views/Home.astro';
import Projects from '../../views/Projects.astro';
import Project from '../../views/Project.astro';
import Studio from '../../views/Studio.astro';
import Gallery from '../../views/Gallery.astro';
import LegalPage from '../../views/LegalPage.astro';
import NotFound from '../../views/NotFound.astro';

export const prerender = false;

const parts = (Astro.params.path ?? '').split('/').filter(Boolean);
const [section = '', slug = ''] = parts;
const single = parts.length === 1;
const known = parts.length === 0 || (section === 'projects' && parts.length <= 2) || (single && ['studio', 'gallery'].includes(section));
// Any other single segment may be a legal page; its view answers 404 itself when there is none.
if (!known && !single) Astro.response.status = 404;
---

{parts.length === 0 ? (
	<Home />
) : section === 'projects' && !slug ? (
	<Projects />
) : section === 'projects' && parts.length === 2 ? (
	<Project slug={slug} />
) : section === 'studio' && single ? (
	<Studio />
) : section === 'gallery' && single ? (
	<Gallery />
) : single ? (
	<LegalPage slug={section} />
) : (
	<NotFound />
)}
