---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" page="notfound">
	<div class="flex min-h-dvh flex-col justify-center px-gutter py-16">
		<p class="type-label text-lime">404</p>
		<h1 class="type-h1 mt-4 max-w-[14em]">Without Identity, who are you?</h1>
		<p class="type-body mt-6 max-w-[30em] text-paper/80">That page isn’t here. The work is.</p>
		<a href="/projects" class="type-label mt-8 inline-block text-lime hover:text-paper">See the projects</a>
	</div>
</Base>
